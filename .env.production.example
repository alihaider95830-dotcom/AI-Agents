# === DATABASE ===
# Get from Supabase dashboard -> Settings -> Database -> Connection string.
# Use the "Session mode" pooler URL for async SQLAlchemy on port 5432.
DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:5432/postgres

# === REDIS ===
# Get from Upstash console -> Redis database -> Connect.
# Use the redis:// TLS-capable endpoint if your provider requires it.
REDIS_URL=redis://:[PASSWORD]@[HOST]:6379

# === APP ===
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Production frontend URL, no trailing slash.
FRONTEND_URL=https://yourdomain.com

# Production API host validation. Use comma-separated hosts.
# Include Railway's generated host until the custom domain is active.
ENVIRONMENT=production
ALLOWED_HOSTS=api.yourdomain.com,your-service.up.railway.app

# === LLM ===
# Use one. Set the other to an empty string.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=

# === SUPABASE ===
# Get from Supabase dashboard -> Project Settings -> API.
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# === STRIPE ===
# Use live keys for production, for example sk_live_... not sk_test_...
# Get price IDs from Stripe Dashboard -> Product catalog.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_AGENCY_PRICE_ID=price_...

# === VERCEL PUBLIC ENV ===
# Set these in Vercel, not Railway.
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# === VECTOR STORE ===
# On Railway this must be a persistent volume path for worker/beat jobs.
VECTOR_STORE_PATH=/app/data/faiss_index

# === ADMIN ===
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# === MONITORING ===
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Send as X-Metrics-Token when scraping /metrics from outside private networks.
METRICS_TOKEN=

# === LOGGING ===
LOG_LEVEL=INFO
